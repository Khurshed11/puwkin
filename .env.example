# ============ Основное ============
# СЮДА ВСТАВИТЬ ТОКЕН БОТА (получить у @BotFather командой /newbot)
BOT_TOKEN=
# ID администраторов через запятую (узнать можно у бота @userinfobot)
ADMIN_IDS=5992735243
# Валюта, в которой указаны цены (для красивого вывода)
CURRENCY=сом

# ============ Менеджер ============
# Username менеджера, который видят клиенты в кнопке "Связь с менеджером"
MANAGER_USERNAME=@khurrshed1

# ============ Автоматизация ============
# True = заказы подтверждаются автоматически (менеджер ничего не делает).
# false = админ подтверждает каждый заказ вручную.
AUTO_CONFIRM_ORDERS=True

# ============ Доставка (видит клиент) ============
# Фиксированный срок доставки, который сообщается клиенту при оформлении
DELIVERY_MIN_DAYS=18
DELIVERY_MAX_DAYS=25

# ============ База данных ============
DB_NAME=shop.db

